const express = require('express');
const { PrismaClient } = require('@prisma/client');


const router = express.Router();
const prisma = new PrismaClient();

router.get('/users', async (req, res) => {
  try {
    const users = await prisma.user.findMany({
      select: {
        id: true,
        email: true,
        name: true,
        tier: true,
        isActive: true,
        createdAt: true,
        _count: { 
          select: { 
            apiKeys: true, 
            apiLogs: true 
          } 
        }
      },
      orderBy: { createdAt: 'desc' }
    });

    
    res.json({
      success: true,
      count: users.length,
      data: users
    });
  } catch (err) {
    console.error('Error fetching users:', err);
    res.status(500).json({ error: 'Failed to fetch users' });
  }
});

router.patch('/users/:userId/tier', async (req, res) => {
  try {
    const userId = parseInt(req.params.userId);
    const { tier } = req.body;
    
    const validTiers = ['free', 'premium', 'pro', 'unlimited'];
    if (!validTiers.includes(tier)) {
      return res.status(400).json({ 
        error: 'Invalid tier',
        validTiers
      });
    }

    const user = await prisma.user.update({
      where: { id: userId },
      data: { tier }
    });

    // Update API key limits
    const tierLimits = {
      'free': 1000,
      'premium': 100000,
      'pro': 1000000,
      'unlimited': 999999999
    };

    await prisma.apiKey.updateMany({
      where: { userId },
      data: { dailyLimit: tierLimits[tier] }
    });

    
    res.json({
      success: true,
      message: `User tier updated to ${tier}`,
      user: {
        id: user.id,
        email: user.email,
        tier: user.tier
      }
    });
  } catch (err) {
    console.error('Error updating user tier:', err);
    res.status(500).json({ error: 'Failed to update user tier' });
  }
});

router.get('/analytics', async (req, res) => {
  try {
    const [totalUsers, totalApiKeys, totalLogs, totalVillages, stats] = await Promise.all([
      prisma.user.count(),
      prisma.apiKey.count(),
      prisma.apiLog.count(),
      prisma.village.count(),
      prisma.apiLog.aggregate({
        _avg: { responseTime: true },
        _min: { responseTime: true },
        _max: { responseTime: true }
      })
    ]);

    const tierDistribution = await prisma.user.groupBy({
      by: ['tier'],
      _count: true
    });

    const topEndpoints = await prisma.apiLog.groupBy({
      by: ['endpoint'],
      _count: { id: true },
      orderBy: { _count: { id: 'desc' } },
      take: 10
    });

    res.json({
      success: true,
      analytics: {
        users: {
          total: totalUsers,
          byTier: tierDistribution.reduce((acc, t) => ({...acc, [t.tier]: t._count}), {})
        },
        api: {
          totalApiKeys,
          totalRequests: totalLogs,
          avgResponseTime: Math.round(stats._avg.responseTime || 0),
          minResponseTime: stats._min.responseTime || 0,
          maxResponseTime: stats._max.responseTime || 0
        },
        data: {
          totalVillages
        },
        topEndpoints: topEndpoints.map(ep => ({
          endpoint: ep.endpoint,
          requests: ep._count.id
        }))
      }
    });
  } catch (err) {
    console.error('Error fetching analytics:', err);
    res.status(500).json({ error: 'Failed to fetch analytics' });
  }
});

router.get('/data-stats', async (req, res) => {
  try {
    const [stateCount, districtCount, subDistrictCount, villageCount] = await Promise.all([
      prisma.state.count(),
      prisma.district.count(),
      prisma.subDistrict.count(),
      prisma.village.count()
    ]);

    const orphanedVillages = await prisma.village.count({
      where: {
        subDistrictId: {
          notIn: await prisma.subDistrict.findMany({
            select: { id: true }
          }).then(sds => sds.map(sd => sd.id))
        }
      }
    });

    res.json({
      success: true,
      dataStats: {
        states: stateCount,
        districts: districtCount,
        subDistricts: subDistrictCount,
        villages: villageCount,
        total: stateCount + districtCount + subDistrictCount + villageCount,
        orphanedRecords: orphanedVillages,
        dataIntegrity: orphanedVillages === 0 ? 'OK' : 'WARNING'
      }
    });
  } catch (err) {
    console.error('Error fetching data stats:', err);
    res.status(500).json({ error: 'Failed to fetch data statistics' });
  }
});

